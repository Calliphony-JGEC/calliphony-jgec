# Frontend — leave empty in local dev (Vite proxies /api → :5000)
VITE_API_URL=

# Shared Cloudinary cloud name (frontend uploads + backend deletes)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Backend
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/calliphony
# Atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/calliphony?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/calliphony?retryWrites=true&w=majority

# false = use MONGODB_URI (persistent data)
# true  = temporary in-memory DB (data wiped when the API restarts)
MEMORY_MONGO=false

JWT_SECRET=change-me-to-a-long-random-string
# Change these anytime, then restart the API — credentials sync into MongoDB
ADMIN_EMAIL=admin@calliphony.local
ADMIN_PASSWORD=admin123

# Cloudinary Admin API keys (cloud name = VITE_CLOUDINARY_CLOUD_NAME)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
